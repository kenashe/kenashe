---
// Organizational context for a build that Lucky Domains owns or operates.
// One line under the build header, in the same register as the "Live since" meta line.
// It is provenance, not promotion: no banner, no button. The link goes to that build's
// page on luckydomains.io, never to the Lucky Domains homepage, contact, or about page.
// See ARCHITECTURE.md "Lucky Domains links".
interface Props {
  /** For example "A Lucky Domains venture". */
  label: string;
  /** The build's own page on luckydomains.io. */
  href: string;
  /** Optional supporting sentence, for example who built and who operates it. */
  note?: string;
}

const { label, href, note } = Astro.props;
---

<p class="provenance">
  <a href={href} target="_blank" rel="noopener">{label}</a>{note && <span class="provenance-note">{note}</span>}
</p>

<style>
  .provenance {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
    margin: -0.6rem 0 1.25rem;
  }
  .provenance a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .provenance-note {
    margin-left: 0.5rem;
  }
</style>
