---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import { readingTime } from '../utils/reading-time';
import { personKenAshe, websiteKenAshe } from '../data/schema';
import { SITE_URL, AUTHOR, DEFAULT_OG_IMAGE } from '../consts';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: { src: ImageMetadata; alt: string };
  tags: string[];
  draft: boolean;
  body: string;
  relatedPosts?: { slug: string; title: string }[];
  sources?: { title: string; url: string }[];
  entities?: { name: string; sameAs: string }[];
}

const { id, title, description, pubDate, updatedDate, image, tags, draft, body, relatedPosts = [], sources = [], entities = [] } = Astro.props;
const { minutes } = readingTime(body ?? '');
const url = new URL(`/blog/${id}/`, SITE_URL).toString();

// Article image for schema / rich results: the post's hero when present, else the
// default OG card. Absolute URL so crawlers can fetch it; the hero's src is the
// full-resolution imported asset, which suits Google's Article image guidance.
const articleImage = new URL(image ? image.src.src : DEFAULT_OG_IMAGE, SITE_URL).toString();

const articleSchema = {
  '@type': 'Article',
  headline: title,
  description,
  image: articleImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  // Digest posts are machine-written: the author is the automated system, the publisher
  // (and accountable party) is Ken. The Person node stays in the graph below.
  author: { '@type': 'Organization', name: 'KenAshe Digest (automated)', url: `${SITE_URL}/blog/` },
  publisher: { '@type': 'Person', '@id': 'https://kenashe.ai/#ken-ashe', name: AUTHOR, url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@id': 'https://kenashe.ai/#website' },
  inLanguage: 'en-US',
  articleSection: tags?.[0],
  url,
  keywords: tags?.join(', '),
  ...(relatedPosts.length
    ? { relatedLink: relatedPosts.map((r) => new URL('/blog/' + r.slug + '/', SITE_URL).toString()) }
    : {}),
  ...(sources.length
    ? {
        citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
        isBasedOn: sources.map((s) => s.url),
      }
    : {}),
  ...(entities.length
    ? { mentions: entities.map((e) => ({ '@type': 'Thing', name: e.name, sameAs: e.sameAs })) }
    : {}),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};

// One @graph per page: the page-specific nodes PLUS the canonical site + person
// entities, so the author/isPartOf @id references resolve on this page alone
// (single-page parsers, i.e. most LLM scrapers, don't crawl the homepage first).
const postSchema = {
  '@context': 'https://schema.org',
  '@graph': [articleSchema, breadcrumbSchema, websiteKenAshe, personKenAshe],
};
---

<BaseLayout
  title={title}
  description={description}
  image={articleImage}
  ogType="article"
  ogImageWidth={image?.src.width}
  ogImageHeight={image?.src.height}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate?.toISOString(),
    tags,
  }}
>
  <Fragment slot="jsonld">
    <JsonLd data={postSchema} />
  </Fragment>

  <article class="post">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/blog/">
        <span aria-hidden="true">←</span> Digest
      </a>
    </nav>

    <aside class="auto-note" aria-label="About this post">
      <p>
        This piece was written and published by an autonomous system Ken built. He is the
        publisher and is accountable for it. It is not a first-person build log.
      </p>
      <p class="auto-note-links">
        <a href="/disclosure/">Disclosure</a>
        <span aria-hidden="true">·</span>
        <a href="/building/autonomous-ai-blog/">How the system works</a>
      </p>
    </aside>

    {
      image && (
        <figure class="hero-image">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 768, 1200, 1600]}
            sizes="(min-width: 720px) 640px, 100vw"
          />
        </figure>
      )
    }

    <header class="post-header">
      {draft && <p class="draft-badge">Draft</p>}
      <h1>{title}</h1>
      {
        tags?.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
      <p class="byline">KenAshe Digest (automated) <span aria-hidden="true">·</span> Ken Ashe, publisher</p>
      <p class="meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true"> · </span>
        <span>{minutes} min read</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                Updated <FormattedDate date={updatedDate} format="short" />
              </span>
            </>
          )
        }
      </p>
      {description && <p class="lead">{description}</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      relatedPosts.length > 0 && (
        <nav class="related" aria-label="Related posts">
          <span class="related-label" aria-hidden="true">// related</span>
          <ul>
            {relatedPosts.map((r) => (
              <li>
                <a href={`/blog/${r.slug}/`}>{r.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="post-links" aria-label="More from KenAshe.ai">
      <span class="post-links-label" aria-hidden="true">// more</span>
      <a href="/building/">See the builds behind the writing</a>
      <a href="/newsroom/">Newsroom</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .crumbs a:hover {
    color: var(--accent);
  }

  .hero-image {
    margin: 0 0 2.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-header {
    margin-bottom: 3rem;
  }
  .draft-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 35%, var(--border));
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    margin: 0 0 1.25rem;
  }
  .post-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1.25rem;
    color: var(--fg);
  }
  .post-tags {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .post-tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.22rem 0.5rem;
    border-radius: 4px;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin: 0 0 1.5rem;
  }
  .lead {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--fg);
    margin: 0;
    max-width: 36rem;
  }

  .related {
    margin: 3.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .related-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .related a {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--fg);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .related a:hover {
    color: var(--accent);
  }

  /* Internal links out of each post (blog -> projects / newsroom). */
  .post-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin: 4rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .post-links-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .post-links a {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--fg);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .post-links a:hover {
    color: var(--accent);
  }
  .auto-note {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
    padding: 0.9rem 1.1rem;
    margin: 0 0 1.75rem;
  }
  .auto-note p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .auto-note-links {
    margin-top: 0.45rem !important;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .auto-note-links a { color: var(--accent); text-decoration: none; }
  .auto-note-links a:hover { text-decoration: underline; }
  .auto-note-links span { color: var(--muted); padding: 0 0.35rem; }
  .byline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .byline span { color: var(--accent); padding: 0 0.3rem; }
</style>
