---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../data/topics';
---

<BaseLayout
  title="Topics"
  description="The areas The Lab covers in depth: AI agents and evals, AI for marketing and ops, building with AI, and AI x digital assets."
>
  <div class="page">
    <header class="page-header">
      <p class="page-mark" aria-hidden="true">// topics</p>
      <h1>Topics</h1>
      <p class="tagline">Subject areas covered in depth within the blog.</p>
    </header>

    <ul class="topic-list">
      {
        topics.map((t) => (
          <li>
            <a href={`/topics/${t.slug}/`}>
              <span class="t">{t.title}</span>
              <span class="d">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 0.75rem;
    color: var(--fg);
  }
  .tagline {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
  }
  .topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .topic-list li {
    border-top: 1px solid var(--border);
  }
  .topic-list a {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: inherit;
    transition: color 150ms ease;
  }
  .topic-list a:hover .t {
    color: var(--accent);
  }
  .topic-list .t {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 0.4rem;
  }
  .topic-list .d {
    display: block;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
