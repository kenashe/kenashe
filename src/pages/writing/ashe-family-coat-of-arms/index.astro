  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }
  .essay-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .meta-key {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .meta span[aria-hidden] {
    color: var(--accent);
    padding: 0 0.35rem;
  }
  .prose {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--fg);
  }
  .prose p {
    margin: 0 0 1.25rem;
  }
  .prose a {
    color: var(--accent);
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 2.5rem 0 0.9rem;
    color: var(--fg);
  }
  .prose blockquote {
    margin: 0 0 1.25rem;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-style: italic;
  }
  .prose blockquote p {
    margin: 0;
  }
  .prose ul {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .prose li {
    margin-bottom: 0.4rem;
  }
  .prose li::marker {
    color: var(--accent);
  }
  /* Figures. The illustrations are black-on-white artwork and a scanned label, so they sit on
     a white mat inside the dark page and are always shown whole (contain, never cropped).
     The main arms are capped near 600px so the tall drawing does not overwhelm the column;
     the smaller images display at or below their native size and are never enlarged. */
  .prose figure {
    margin: 2rem auto;
    text-align: center;
  }
  .prose figure :global(img) {
    display: block;
    margin: 0 auto;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .arms {
    max-width: 600px;
  }
  .arms :global(img) {
    background: #fff;
    border: 1px solid var(--border);
  }
  .spot.shield {
    max-width: 112px;
    margin: 1.5rem auto 1.75rem;
  }
  .spot.label {
    max-width: 328px;
  }
  .spot.pint {
    max-width: 315px;
  }
  .prose figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--muted);
  }
  /* Small link to the companion YouTube Short, just above the sources list. */
  .prose .watch {
    margin: 2.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  .watch a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent);
    text-decoration: none;
    transition: border-color 150ms ease, opacity 150ms ease;
  }
  .watch a:hover,
  .watch a:focus-visible {
    border-color: var(--accent);
  }
  .watch-icon {
    flex: none;
  }
  .sources {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
