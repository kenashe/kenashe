    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .meta-key {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .meta span[aria-hidden] {
    color: var(--accent);
    padding: 0 0.35rem;
  }
  .prose {
    font-family: var(--font-sans);
