---
// The human lane. Everything here is written by Ken, not the pipeline. These are static
// pages ON PURPOSE: the blog content collection is the autonomous digest, and adding an
// `origin` field to the collection schema would touch src/content.config.ts, which is
// frozen (DECISIONS.md D15 — any byte change to it colds the build past Vercel's timeout).
import BaseLayout from '../../layouts/BaseLayout.astro';

const essays = [
  {
    href: '/writing/the-digest-is-the-system/',
    title: 'The digest is the system. Building is the work.',
    date: 'August 2026',
    dek: 'Why the autonomous blog stops being the public face of this site, and what stands behind it instead.',
  },
];
---

<BaseLayout
  title="Writing"
  description="Occasional human-written essays from Ken Ashe. Everything here is written by hand; the machine-published feed lives in the Digest."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing/' },
  ]}
>
  <div class="page">
    <header class="page-header">
      <p class="page-mark" aria-hidden="true">// writing</p>
      <h1>Writing</h1>
      <p class="lede">
        Occasional essays, written by hand. Rare on purpose. The machine-published feed lives in
        the <a href="/blog/">Digest</a>; the receipts live in <a href="/building/">Building</a>.
      </p>
    </header>

    <ul class="essays">
      {
        essays.map((e) => (
          <li>
            <a href={e.href}>
              <span class="essay-date">{e.date}</span>
              <span class="essay-title">{e.title}</span>
              <span class="essay-dek">{e.dek}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="pointers" aria-label="Elsewhere on the site">
      <a href="/building/">Building →</a>
      <a href="/blog/">Digest →</a>
      <a href="/disclosure/">How content is made →</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .lede {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 38rem;
  }
  .lede a {
    color: var(--accent);
  }
  .essays {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .essays li {
    border-top: 1px solid var(--border);
  }
  .essays a {
    display: block;
    padding: 1.4rem 0;
    text-decoration: none;
    color: inherit;
  }
  .essays a:hover .essay-title {
    color: var(--accent);
  }
  .essay-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .essay-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 0.4rem;
  }
  .essay-dek {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .pointers {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .pointers a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .pointers a:hover {
    color: var(--accent);
  }
</style>
