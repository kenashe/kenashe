---
// The human lane. Everything here is written by Ken, not the pipeline. These are static
// pages ON PURPOSE: the blog content collection is the autonomous digest, and adding an
// `origin` field to the collection schema would touch src/content.config.ts, which is
// frozen (DECISIONS.md D15 — any byte change to it colds the build past Vercel's timeout).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { essays, hrefFor } from '../../data/writing';
import { coverOf } from '../../data/writing-images';

// Thumbnails are derived, never listed here: coverOf() reads each essay's declared image
// (writing.ts) and checks the page displays it, falling back to the first inline figure.
// An essay with no suitable image renders text-only, and the build log says so.
const listing = essays.map((e) => ({ essay: e, cover: coverOf(e) }));
---

<BaseLayout
  title="Writing"
  description="Occasional essays Ken Ashe directs, edits, and stands behind, with AI assistance disclosed on each page. The machine-published feed lives in the Digest."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing/' },
  ]}
>
  <div class="page">
    <header class="page-header">
      <p class="page-mark" aria-hidden="true">// writing</p>
      <h1>Writing</h1>
      <p class="lede">
        Occasional essays I direct, edit, and stand behind. AI assistance is disclosed on each
        page. The machine-published feed lives in the <a href="/blog/">Digest</a>; the receipts
        live in <a href="/building/">Building</a>.
      </p>
    </header>

    <ul class="essays">
      {
        listing.map(({ essay: e, cover }) => (
          <li>
            <a href={hrefFor(e)}>
              <span class="essay-text">
                <span class="essay-date">{e.date}</span>
                <span class="essay-title">{e.title}</span>
                <span class="essay-dek">{e.dek}</span>
              </span>
              {/* Decorative here: the link's text already names the essay, so alt is empty. */}
              {cover?.kind === 'asset' && (
                <span class="essay-thumb">
                  <Image
                    src={cover.image}
                    alt=""
                    widths={[240, 480, 720]}
                    sizes="(min-width: 40rem) 240px, calc(100vw - 3rem)"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              {cover?.kind === 'inline' && (
                <span class="essay-thumb">
                  <img
                    src={cover.src}
                    alt=""
                    width={cover.width}
                    height={cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="pointers" aria-label="Elsewhere on the site">
      <a href="/building/">Building →</a>
      <a href="/blog/">Digest →</a>
      <a href="/disclosure/">How content is made →</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .lede {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 38rem;
  }
  .lede a {
    color: var(--accent);
  }
  .essays {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .essays li {
    border-top: 1px solid var(--border);
  }
  /* One column, as before. Mobile: thumbnail stacked above the text. Desktop: a 240px
     landscape thumbnail to the right of the text. The thumbnail lives inside the same link
     as the title, so it goes to the same essay without a second tab stop. */
  .essays a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.4rem 0;
    text-decoration: none;
    color: inherit;
  }
  .essays a:hover .essay-title {
    color: var(--accent);
  }
  .essay-text {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
  }
  .essay-thumb {
    display: block;
    order: -1;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--border);
  }
  .essay-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 40rem) {
    .essays a {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .essay-thumb {
      order: 0;
      flex: 0 0 240px;
      width: 240px;
    }
  }
  .essay-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .essay-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 0.4rem;
  }
  .essay-dek {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .pointers {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .pointers a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .pointers a:hover {
    color: var(--accent);
  }
</style>
