---
import BuildLayout from '../../layouts/BuildLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

const title = 'Returning Your Things';
const path = '/building/returning-your-things/';
const logline = 'On a snowy winter night, a man crosses the city to return his ex’s belongings.';
const description = `${logline} A short film by Ken Ashe about love, memory, and letting go, told without dialogue.`;
const videoId = 'QhOYaj_bDZY';
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}`;
const image = '/images/building/returning-your-things.webp';
const recordingUrl = 'https://commons.wikimedia.org/wiki/File:Robert_Schumann_-_scenes_from_childhood,_op._15_-_i._of_foreign_lands_and_peoples.ogg';
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Returning Your Things | A Short Film by Ken Ashe',
  description,
  thumbnailUrl: new URL(image, 'https://kenashe.ai').href,
  uploadDate: '2026-11-19',
  duration: 'PT1M54S',
  embedUrl,
  url: watchUrl,
};
---

<BuildLayout
  title={title}
  description={description}
  {image}
  ogImageWidth={1280}
  ogImageHeight={720}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Building', path: '/building/' },
    { name: title, path },
  ]}
>
  <Fragment slot="jsonld"><JsonLd data={videoSchema} /></Fragment>
  <article class="film">
    <nav class="mono crumb" aria-label="Breadcrumb"><a href="/building/"><span aria-hidden="true">←</span> Building</a></nav>
    <header>
      <p class="mono label">// short film</p>
      <h1>{title}</h1>
      <p class="mono details">An original short film by Ken Ashe · 2026 · <time datetime="PT1M54S">1:54</time></p>
      <p class="logline">{logline}</p>
      <p class="theme">A story about love, memory, and letting go, told without dialogue.</p>
    </header>
    <figure id="film">
      <div class="video">
        <iframe
          src={`${embedUrl}?rel=0`}
          title="Returning Your Things, a short film by Ken Ashe"
          width="560"
          height="315"
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <figcaption class="mono"><a href={watchUrl} target="_blank" rel="noopener">Watch on YouTube ↗</a></figcaption>
    </figure>
    <section aria-labelledby="director-note">
      <h2 id="director-note">Director’s Note</h2>
      <p>I made <em>Returning Your Things</em> with AI-generated imagery. I wanted to see if I could tell a whole story without dialogue, using only images and music. The film needed to stand on its own, whether or not you knew how I made it.</p>
    </section>
    <section aria-labelledby="credits">
      <h2 id="credits">Credits</h2>
      <p><strong>Film by:</strong> Ken Ashe<br />
        <strong>Music:</strong> Robert Schumann, “Of Foreign Lands and Peoples,” <em>Kinderszenen</em>, Op. 15, No. 1<br />
        <strong>Piano:</strong> Donald Betts. Public-domain recording courtesy of Musopen, via <a href={recordingUrl}>Wikimedia Commons</a>.
      </p>
    </section>
  </article>
</BuildLayout>

<style>
  .film { max-width: var(--reading-width); margin: 0 auto; padding: 4rem 1.5rem 0; color: var(--fg); line-height: 1.7; }
  .mono { font-family: var(--font-mono); font-size: 0.8125rem; }
  .crumb { text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2.5rem; }
  .crumb a, .details { color: var(--muted); }
  .crumb a { text-decoration: none; }
  .crumb a:hover, a, .label { color: var(--accent); }
  .label { letter-spacing: 0.12em; margin: 0 0 1rem; }
  h1, h2 { font-family: var(--font-display); letter-spacing: -0.03em; line-height: 1.1; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); font-weight: 800; margin: 0; }
  h2 { font-size: clamp(1.5rem, 3vw, 1.875rem); font-weight: 700; margin: 2.5rem 0 0.85rem; }
  .details { margin: 0.85rem 0 1.5rem; }
  .logline { font-size: 1.125rem; margin-bottom: 0.25rem; }
  .theme { color: var(--muted); }
  figure { margin: 1.75rem 0 0; }
  .video { aspect-ratio: 16 / 9; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: var(--border); }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
  figcaption { margin-top: 0.65rem; }
  section p { font-size: 1.0625rem; }
  @media (max-width: 560px) { .film { padding-top: 2.75rem; } }
</style>
