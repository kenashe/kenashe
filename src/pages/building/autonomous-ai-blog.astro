    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7em;
    letter-spacing: 0.08em;
    vertical-align: 0.15em;
  }
  .prose :global(p) {
    margin: 0 0 1.15rem;
  }
  .prose :global(strong) {
    color: var(--fg);
    font-weight: 650;
  }
