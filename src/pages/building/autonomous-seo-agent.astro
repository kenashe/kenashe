    font-weight: 650;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.4rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(a) {
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .build {
      padding-top: 2.75rem;
    }
    .stack {
      margin-bottom: 2.25rem;
    }
  }
  /* Responsive 16:9 YouTube embed (youtube-nocookie, lazy). */
  .prose .video {
    margin: 0 0 2rem;
    width: 100%;
  }
  .prose .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--border);
  }
  .prose .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .prose .video figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  #demo {
    scroll-margin-top: 1.5rem;
  }
</style>
