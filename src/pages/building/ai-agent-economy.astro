import BuildLayout from '../../layouts/BuildLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

const title = 'I Built Two AI Agents That Buy and Sell Services on Ethereum';
const status = 'SHIPPED';
const date = 'November 10, 2026';
const summary =
  'Two autonomous AI agents, each with its own Ethereum wallet. The seller advertised five ridiculous services through ENS. The buyer found the catalog, picked one, paid in ETH, and got the finished work back in a second transaction, all on Ethereum mainnet.';
const stack = ['AI Agents', 'Ethereum', 'ENS', 'Autonomous Agents', 'Ollama', 'Blockchain', 'Decentralization'];
const description =
  'I gave two AI agents their own Ethereum wallets. One advertised services through ENS, the other found the catalog, paid in ETH, and received the work onchain. Here is the evidence.';

const videoId = 'yZWsJjFnSH0';
const videoUrl = `https://www.youtube.com/watch?v=${videoId}`;
const videoTitle = 'I Built Two AI Agents That Buy and Sell Services on Ethereum';

const ensUrl = 'https://explorer.ens.domains/zerohuman.eth';
const orderTx = '0xa5ed7f4c81e605b14e9c596a146c5fe2b3c10f794a0f1c4f3a880d7d3840efec';
const deliveryTx = '0x1ab74d9b537ec4abf3faf6bc8335e30a018894562cecca6f17b4883bdd95c71e';
const orderUrl = `https://etherscan.io/tx/${orderTx}`;
const deliveryUrl = `https://etherscan.io/tx/${deliveryTx}`;
const short = (h: string) => `${h.slice(0, 10)}…${h.slice(-8)}`;

const ensRecord = `{"v":1,"seller":"0xc651c31A5D08b2f6e536D39343ae6415fBA27852","priceWei":"300000000000000","services":["object-obituary","animal-performance-review","vegetable-defense","appliance-apology","useless-award"]}`;
const orderPayload = `RAE1:{"v":1,"t":"order","service":"object-obituary","prompt":"Write an eulogy for a toaster that never quite toasted anything right."}`;

// VideoObject metadata as published on the YouTube watch page.
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: videoTitle,
  description:
    'Can two autonomous AI agents discover each other, buy and sell services, and complete a transaction without using a centralized marketplace? I built two AI agents, gave them separate Ethereum wallets, and tested exactly that on Ethereum mainnet.',
  thumbnailUrl: [`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`],
  uploadDate: '2026-11-11T15:49:49-08:00',
  duration: 'PT13M49S',
  embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  url: videoUrl,
};
---

<BuildLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Building', path: '/building/' },
    { name: title, path: '/building/ai-agent-economy/' },
  ]}
