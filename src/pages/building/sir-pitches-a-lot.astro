import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Sir Pitches-a-Lot';
const status = 'SHIPPED';
const date = 'August 2026';
const summary = 'A HyperAgent competition agent that researched an anonymized founder target, pitched Lucky Domains, and generated a personalized landing page campaign designed around one question: would they reply?';
const stack = ['HyperAgent', 'Airtable', 'Lucky Domains', 'Prompt Engineering', 'Founder-Led Sales', 'Landing Pages', 'Outbound Automation'];
---

<BaseLayout
  title={title}
  description={summary}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Building', path: '/building/' },
    { name: title, path: '/building/sir-pitches-a-lot/' },
  ]}
>
  <article class="build">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/building/"><span aria-hidden="true">&larr;</span> Building</a>
    </nav>

    <header class="build-header">
      <p class="page-mark" aria-hidden="true">// build</p>
      <div class="title-row">
        <h1>{title}</h1>
        <span class={`badge badge-${status.toLowerCase()}`}>
