---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, status, date, stack, summary } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={title}
  description={summary}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Building', path: '/building/' },
    { name: title, path: `/building/${entry.id}/` },
  ]}
>
  <article class="build">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/building/"><span aria-hidden="true">←</span> Building</a>
    </nav>

    <header class="build-header">
      <p class="page-mark" aria-hidden="true">// build</p>
      <div class="title-row">
        <h1>{title}</h1>
        <span class={`badge badge-${status.toLowerCase()}`}>
          <span class="badge-dot" aria-hidden="true"></span>
          {status}
        </span>
      </div>
      <p class="summary">{summary}</p>
      <p class="meta">
        <span class="meta-key">{status === 'LIVE' ? 'Live since' : 'Shipped'}</span>
        {date}
      </p>
      <ul class="stack" aria-label="Stack">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .build {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 1.1rem;
  }
  .build-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
    color: var(--fg);
  }
  /* Status badge: same treatment as the Building cards. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
    background-color: var(--bg);
  }
  .badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background-color: currentColor;
  }
  .badge-live {
    color: var(--accent-2);
    border-color: color-mix(in oklab, var(--accent-2) 35%, var(--border));
  }
  .badge-live .badge-dot {
    background-color: var(--accent-2);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent-2) 18%, transparent);
  }
  .badge-shipped {
    color: #94a3b8;
    border-color: rgb(100 116 139 / 0.2);
    background-color: rgb(100 116 139 / 0.1);
  }
  .badge-shipped .badge-dot {
    background-color: #64748b;
  }
  .summary {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 1.1rem;
    max-width: 42rem;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg);
    margin: 0 0 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .meta-key {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-right: 0.4rem;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
  }

  /* Markdown body */
  .prose {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--fg);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 2.75rem 0 1rem;
    color: var(--fg);
  }
  .prose :global(h2::before) {
    content: '// ';
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7em;
    letter-spacing: 0.08em;
    vertical-align: 0.15em;
  }
  .prose :global(p) {
    margin: 0 0 1.15rem;
  }
  .prose :global(strong) {
    color: var(--fg);
    font-weight: 650;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.4rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(a) {
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .build {
      padding-top: 2.75rem;
    }
    .stack {
      margin-bottom: 2.25rem;
    }
  }
</style>
