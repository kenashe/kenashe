---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Phase 0 - Newsroom + orphan fix (spec v2.2 §13/§18).
// Built on the EXISTING stack and visual conventions; the §3 bright-AI-lab
// visual system is Phase 1 and intentionally NOT applied here.
// Existing JSON-LD/entity work is untouched. This index links TO the existing
// release pages (it does not move, copy, or re-host them).

const description =
  'Newsroom for Ken Ashe: press releases, media kit, fast facts, and press contact for media covering practical AI application building.';

// Press releases live at their existing canonical URLs. We link to them here;
// we do not duplicate or rewrite them. Headlines/deks are the actual live text.
const releases = [
  {
    date: 'June 24, 2026',
    title:
      'KenAshe.ai Launches as a Public Build Log for Practical AI Projects and Website Development',
    href: '/news/site-launch/',
    external: false,
    summary:
      'Personal site from AI operator Ken Ashe documents AI builds, website development, automation experiments, and the process of building with AI in public',
  },
  {
    date: 'June 24, 2026',
    title:
      'Lucky Domains Launches Redesigned Website for Premium Domain Acquisition and SEO',
    href: 'https://luckydomains.io/news/website-relaunch.html',
    external: true,
    summary:
      'LuckyDomains.io positions the company as a focused partner for businesses that need a better domain name and durable search visibility',
  },
];

const sections = [
  { id: 'coverage', label: 'Coverage & Mentions' },
  { id: 'bylines', label: 'Bylines' },
  { id: 'press-releases', label: 'Press Releases' },
  { id: 'media-kit', label: 'Media Kit' },
  { id: 'available-for-comment', label: 'Available for Comment' },
  { id: 'fast-facts', label: 'Fast Facts' },
  { id: 'press-contact', label: 'Press Contact' },
];

const speakingTopics = [
  'Building with AI in public',
  'Practical AI for operators and non-engineers',
  'AI agents and workflow automation',
  'AI-assisted website development',
  'AI coding tools in real projects',
  'Marketing operations automation',
  'AI automation case studies',
];
---

<BaseLayout
  title="Newsroom"
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Newsroom', path: '/newsroom/' },
  ]}
>
  <div class="page newsroom">
    <header class="page-header">
      <p class="page-mark" aria-hidden="true">// newsroom</p>
      <h1>Newsroom</h1>
      <p class="tagline">
        Press releases, media kit, and fast facts for journalists, podcasters, and editors
        covering Ken Ashe and KenAshe.ai. For interviews or comment, see
        <a href="#press-contact">Press Contact</a>.
      </p>
      <nav class="jump" aria-label="Newsroom sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>

    <!-- COVERAGE & MENTIONS: third-party editorial coverage, quotations, and source credits. Not verification of anything. Sorted newest first by original publication date. -->
    <section class="block" id="coverage" aria-labelledby="coverage-h">
      <h2 id="coverage-h">Selected Coverage &amp; Mentions</h2>
      <ul class="release-list">
        <li class="release">
          <p class="meta">July 8, 2026 · Explore New Jersey</p>
          <h3>
            <a
              href="https://explorenewjersey.org/kenashe-ai/"
              target="_blank"
              rel="noopener">New Jersey Operator Ken Ashe Launches KenAshe.ai, a Public Build Log for Real AI Projects</a
            >
          </h3>
          <p class="summary">
            Launch write-up covering KenAshe.ai and its focus on documenting practical AI projects in
            public.
          </p>
          <p class="more">
            <a
              href="https://explorenewjersey.org/kenashe-ai/"
              target="_blank"
              rel="noopener">Read on ExploreNewJersey.org ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">November 26, 2024 · Cryptoast</p>
          <h3>
            <a
              href="https://cryptoast.fr/democratisation-bitcoin-pourrait-elle-passer-par-gamification/"
              target="_blank"
              rel="noopener">La démocratisation du Bitcoin pourrait-elle passer par la « gamification » ?</a
            >
          </h3>
          <p class="summary">
            Bitcoin adoption graphic credited to Ken Ashe, "The Defi PM," in a French-language article exploring gamification and cryptocurrency education. A source credit for the graphic, not a quotation or interview.
          </p>
          <p class="more">
            <a
              href="https://cryptoast.fr/democratisation-bitcoin-pourrait-elle-passer-par-gamification/"
              target="_blank"
              rel="noopener">Read on Cryptoast.fr ↗</a
            >
          </p>
        </li>
        <!-- archive: https://web.archive.org/web/20170222225800/https://www.yahoo.com/news/7-smart-ways-spend-1-000-tax-refund-183159556.html -->
        <li class="release">
          <p class="meta">February 2017 · <em>U.S. News &amp; World Report</em> (syndicated)</p>
          <h3>
            <a
              href="https://wtop.com/news/2017/02/7-smart-ways-to-spend-a-1000-tax-refund/"
              target="_blank"
              rel="noopener">7 Smart Ways to Spend a $1,000 Tax Refund</a
            >
          </h3>
          <p class="summary">
            Quoted on using a tax refund to invest in yourself. Published by U.S. News &amp; World
            Report and syndicated; linked here via WTOP.
          </p>
          <p class="more">
            <a
              href="https://wtop.com/news/2017/02/7-smart-ways-to-spend-a-1000-tax-refund/"
              target="_blank"
              rel="noopener">Read on WTOP.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">February 1, 2017 · <em>Journal of Accountancy</em></p>
          <h3>
            <a
              href="https://www.journalofaccountancy.com/issues/2017/feb/finding-a-mentor/"
              target="_blank"
              rel="noopener">Find a mentor, land a new job</a
            >
          </h3>
          <p class="summary">
            A Journal of Accountancy career feature profiling Ken Ashe's move from financial
            reporting into project management at Prudential.
          </p>
          <p class="more">
            <a
              href="https://www.journalofaccountancy.com/issues/2017/feb/finding-a-mentor/"
              target="_blank"
              rel="noopener">Read on JournalofAccountancy.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">January 2017 · mrc's Cup of Joe Blog</p>
          <h3>
            <a
              href="https://www.mrc-productivity.com/blog/2017/01/how-to-build-a-dashboard-that-your-executives-will-love-2/"
              target="_blank"
              rel="noopener">How to build a dashboard that your executives will love</a
            >
          </h3>
          <p class="summary">
            Quoted on using visual indicators and charts to make executive dashboards easier to interpret.
          </p>
          <p class="more">
            <a
              href="https://www.mrc-productivity.com/blog/2017/01/how-to-build-a-dashboard-that-your-executives-will-love-2/"
              target="_blank"
              rel="noopener">Read on mrc-productivity.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">May 16, 2016 · CertWise</p>
          <h3>
            <a
              href="https://certwise.com/blog/5-project-management-fundamentals-learned-hard-way-dont/"
              target="_blank"
              rel="noopener">5 Project Management Fundamentals Learned the Hard Way (So You Don't Have To)</a
            >
          </h3>
          <p class="summary">
            Quoted on preventing scope creep through clearly defined project boundaries and change management.
          </p>
          <p class="more">
            <a
              href="https://certwise.com/blog/5-project-management-fundamentals-learned-hard-way-dont/"
              target="_blank"
              rel="noopener">Read on CertWise.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">February 12, 2016 · HuffPost (Contributor platform)</p>
          <h3>
            <a
              href="https://www.huffpost.com/entry/email-urgency-vs-actual-e_b_9212690"
              target="_blank"
              rel="noopener">Email Urgency vs. Actual Emergency</a
            >
          </h3>
          <p class="summary">
            Quoted on scheduling email checks rather than reading each message on arrival. Published on HuffPost's now-closed Contributor platform.
          </p>
          <p class="more">
            <a
              href="https://www.huffpost.com/entry/email-urgency-vs-actual-e_b_9212690"
              target="_blank"
              rel="noopener">Read on HuffPost.com ↗</a
            >
          </p>
        </li>
      </ul>
    </section>

    <!-- BYLINES: pieces Ken wrote that a third-party platform published. Kept separate from
         Coverage (third parties writing about him). -->
    <section class="block" id="bylines" aria-labelledby="bylines-h">
      <h2 id="bylines-h">Bylines</h2>
      <ul class="release-list">
        <li class="release">
          <p class="meta">December 29, 2016 · Investing.com</p>
          <h3>
            <a
              href="https://www.investing.com/analysis/seven-reasons-to-invest-in-bank-of-america-heading-in-2017-200171060"
              target="_blank"
              rel="noopener">7 Reasons To Invest In Bank Of America Heading In 2017</a
            >
          </h3>
          <p class="more">
            <a
              href="https://www.investing.com/analysis/seven-reasons-to-invest-in-bank-of-america-heading-in-2017-200171060"
              target="_blank"
              rel="noopener">Read on Investing.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">December 23, 2016 · Investing.com</p>
          <h3>
            <a
              href="https://www.investing.com/analysis/it's-the-big-banks-time-to-shine-200170694"
              target="_blank"
              rel="noopener">It's The Big Banks Time To Shine</a
            >
          </h3>
          <p class="more">
            <a
              href="https://www.investing.com/analysis/it's-the-big-banks-time-to-shine-200170694"
              target="_blank"
              rel="noopener">Read on Investing.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">August 17, 2016 · Project Times</p>
          <h3>
            <a
              href="https://www.projecttimes.com/articles/project-budgets-and-roi/"
              target="_blank"
              rel="noopener">Project Budgets and ROI</a
            >
          </h3>
          <p class="summary">
            Applying budget ranges, ROI, and net present value to project estimating.
          </p>
          <p class="more">
            <a
              href="https://www.projecttimes.com/articles/project-budgets-and-roi/"
              target="_blank"
              rel="noopener">Read on ProjectTimes.com ↗</a
            >
          </p>
        </li>
        <li class="release">
          <p class="meta">February 11, 2016 · ProjectManagement.com (PMI)</p>
          <h3>
            <a
              href="https://www.projectmanagement.com/articles/318225/Personal-Branding--An-Important-Step"
              target="_blank"
              rel="noopener">Personal Branding: An Important Step</a
            >
          </h3>
          <p class="summary">
            Written for PMI's ProjectManagement.com. Free registration required to read in full.
          </p>
          <p class="more">
            <a
              href="https://www.projectmanagement.com/articles/318225/Personal-Branding--An-Important-Step"
              target="_blank"
              rel="noopener">Read on ProjectManagement.com ↗</a
            >
          </p>
        </li>
      </ul>
    </section>

    <!-- PRESS RELEASES -->
    <section class="block" id="press-releases" aria-labelledby="press-releases-h">
      <h2 id="press-releases-h">Press Releases</h2>
      <ul class="release-list">
        {
          releases.map((r) => (
            <li class="release">
              <p class="meta">{r.date}</p>
              <h3>
                {r.external ? (
                  <a href={r.href} target="_blank" rel="noopener">
                    {r.title}
                  </a>
                ) : (
                  <a href={r.href}>{r.title}</a>
                )}
              </h3>
              <p class="summary">{r.summary}.</p>
              <p class="more">
                {r.external ? (
                  <a href={r.href} target="_blank" rel="noopener">
                    Read on LuckyDomains.io ↗
                  </a>
                ) : (
                  <a href={r.href}>Read the full release →</a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- MEDIA KIT -->
    <section class="block" id="media-kit" aria-labelledby="media-kit-h">
      <h2 id="media-kit-h">Media Kit</h2>
      <p class="note">
        Preferred identification: <strong>Ken Ashe · AI application builder, CPA, PMP</strong>.
      </p>

      <h3 class="mk-sub">Short bio</h3>
      <p class="bio">
        Ken Ashe is a CPA, PMP, and AI application builder who documents what he ships, what breaks, and what the evidence supports at KenAshe.ai. He builds agents, automations, and AI-assisted websites at the application layer and is the founder of Lucky Domains, a domain acquisition, brokerage, and SEO company.
      </p>

      <h3 class="mk-sub">Standard bio</h3>
      <p class="bio">
        Ken Ashe is a CPA, PMP, and AI application builder who builds and evaluates AI systems in public at KenAshe.ai, documenting what ships, what breaks, and what the evidence supports. He works at the application layer, combining existing models, APIs, coding tools, and automation platforms into agents, automations, AI-assisted websites, and marketing workflows, rather than training models or building infrastructure. His background is in accounting and finance, followed by roughly two decades of project, product, and program leadership, including at Prudential Financial. That experience shows up in how he tests his own systems: controls, evidence, and delivery discipline over claims. He is also the founder of Lucky Domains, a domain acquisition, brokerage, and SEO company. Based in New Jersey, Ashe builds with AI in public under his own name and treats the shipped work itself as the credential.
      </p>

      <h3 class="mk-sub">About KenAshe.ai</h3>
      <p class="bio">
        KenAshe.ai is the public build log of Ken Ashe, a CPA, PMP, and AI application builder. It documents practical AI work as it happens: shipped builds, experiments, essays Ashe directs and edits, and honest notes on failures alongside results, so other builders can see the evidence rather than the claims. The site also carries the Digest, a daily AI brief written and published by an autonomous system Ashe built and is accountable for. The Digest is machine-published and labeled as automated on every page.
      </p>

      <h3 class="mk-sub">Media assets</h3>
      <div class="assets">
        <figure class="asset">
          <picture>
            <source
              type="image/webp"
              srcset="/images/newsroom/ken-ashe-320.webp 320w, /images/newsroom/ken-ashe-480.webp 480w"
              sizes="320px"
            />
            <img src="/images/ken-ashe.jpeg" alt="Headshot of Ken Ashe" width="320" height="343" loading="lazy" decoding="async" />
          </picture>
          <figcaption>
            Current headshot
            <a href="/images/ken-ashe.jpeg" download>Download JPEG</a>
          </figcaption>
        </figure>

        <figure class="asset asset-logo">
          <img src="/images/kenashe-ai-logo.svg" alt="KenAshe.ai logo" width="1956" height="396" loading="lazy" decoding="async" />
          <figcaption>
            KenAshe.ai logo (SVG, transparent)
            <a href="/images/kenashe-ai-logo.svg" download>Download SVG</a>
          </figcaption>
        </figure>

        <figure class="asset">
          <picture>
            <source
              type="image/webp"
              srcset="/images/newsroom/og-default-640.webp 640w, /images/newsroom/og-default-960.webp 960w"
              sizes="320px"
            />
            <img src="/og-default.png" alt="KenAshe.ai social card image" width="320" height="213" loading="lazy" decoding="async" />
          </picture>
          <figcaption>
            KenAshe.ai social card (PNG, 1200 x 630)
            <a href="/og-default.png" download>Download PNG</a>
          </figcaption>
        </figure>
      </div>

      <h3 class="mk-sub">Media inquiries</h3>
      <p class="note">
        Interview requests, comment, and corrections: see <a href="#press-contact">Press Contact</a>.
      </p>
    </section>

    <!-- AVAILABLE FOR COMMENT -->
    <section class="block" id="available-for-comment" aria-labelledby="afc-h">
      <h2 id="afc-h">Available for Comment</h2>
      <p class="lead-line">
        Available for media interviews, podcast appearances, speaking, and AI commentary.
      </p>
      <ul class="topics">
        {speakingTopics.map((t) => <li>{t}</li>)}
      </ul>
      <p class="more"><a href="#press-contact">How to reach out →</a></p>
    </section>

    <!-- FAST FACTS -->
    <section class="block" id="fast-facts" aria-labelledby="ff-h">
      <h2 id="ff-h">Fast Facts</h2>
      <dl class="facts">
        <dt>Name</dt><dd>Ken Ashe</dd>
        <dt>Site</dt><dd><a href="/">kenashe.ai</a></dd>
        <dt>Location</dt><dd>New Jersey, USA</dd>
        <dt>Role</dt><dd>AI application builder</dd>
        <dt>Background</dt><dd>CPA, PMP, digital marketer, AI builder</dd>
        <dt>Focus</dt><dd>Agents, automations, AI-assisted websites, workflow systems</dd>
      </dl>
    </section>

    <!-- PRESS CONTACT -->
    <section class="block" id="press-contact" aria-labelledby="pc-h">
      <h2 id="pc-h">Press Contact</h2>
      <p class="lead-line">
        Media inquiries, interview requests, and comment: <a href="mailto:hello@kenashe.ai"
          >hello@kenashe.ai</a
        >.
      </p>
      {/*
        OPEN QUESTION (was leaking to the published page as visible text until 2026-08-18):
        a dedicated media contact form (general / media / speaking) was planned for a Phase 1
        Contact page. Email above is the press contact until that exists. Note /contact and
        /about currently 301 to the homepage (see vercel.json), so a Contact page would need
        those redirects removed first.
      */}
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .page-header {
    margin-bottom: 3rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .tagline {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }
  .tagline a { color: var(--fg); }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 1rem;
    border-top: 1px solid var(--rule, var(--border));
  }
  .jump a { color: var(--muted); text-decoration: none; }
  .jump a:hover { color: var(--accent); }

  .block {
    margin: 3.25rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule, var(--border));
  }
  .block > h2 {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.6rem;
    color: var(--fg);
  }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .summary { margin: 0 0 0.6rem; color: var(--fg); line-height: 1.55; }
  .more { margin: 0; font-family: var(--font-sans); font-size: 0.9375rem; }
  .more a, .links a, .facts a { color: var(--accent); }

  .release-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }

  .mk-sub {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    margin: 2rem 0 0.75rem;
  }
  .note { color: var(--muted); font-size: 0.9375rem; line-height: 1.55; }
  .bio-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.1rem 0 0.35rem;
  }
  .bio { margin: 0 0 0.75rem; line-height: 1.65; color: var(--fg); }

  .assets { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 0.5rem 0; }
  .asset { margin: 0; max-width: 320px; }
  .asset img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 6px; }
  .asset figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .asset figcaption a { color: var(--accent); }
  .asset-logo img {
    background: #FDFDFD;
    padding: 1.1rem;
  }

  .topics { margin: 0; padding-left: 1.1rem; line-height: 1.7; color: var(--fg); }
  .topics li { margin: 0.1rem 0; }

  .lead-line { font-size: 1.0625rem; line-height: 1.55; color: var(--fg); margin: 0 0 1rem; }

  .facts { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; }
  .facts dt { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0; color: var(--fg); }
</style>
