---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { topics } from '../../data/topics';

// Everything in the blog collection is the autonomous digest (see AGENTS.md: the
// human lane lives at /writing/ as static pages, deliberately outside this collection).
const all = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const posts = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Full cards for the latest posts; the long tail collapses into a compact,
// month-grouped archive so the index stops being one gigantic page of image cards.
const RECENT = 30;
const recent = posts.slice(0, RECENT);
const archive = posts.slice(RECENT);
const byMonth = new Map<string, typeof archive>();
for (const p of archive) {
  const key = p.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const g = byMonth.get(key) ?? [];
  g.push(p);
  byMonth.set(key, g);
}
---

<BaseLayout
  title="Digest"
  description="Machine-published daily brief on AI systems, papers, and operator news. Built and owned by Ken Ashe. Not personally edited before publish."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Digest', path: '/blog/' },
  ]}
>
  <div class="page">
    <header class="page-header">
      <p class="page-mark" aria-hidden="true">// digest</p>
      <h1>Digest</h1>
      <p class="lede">
        Machine-published daily brief on AI systems, papers, and operator news. Built and owned by
        Ken Ashe. Not personally edited before publish.
      </p>
      <p class="rss">
        <a href="/rss.xml">RSS →</a>
      </p>
    </header>

    <aside class="auto-note" aria-label="How this feed is made">
      <p>
        This feed is written and published by an autonomous system Ken built. He is the publisher
        and is accountable for it. It is not a first-person build log.
      </p>
      <p class="auto-note-links">
        <a href="/disclosure/">Disclosure</a>
        <span aria-hidden="true">·</span>
        <a href="/building/autonomous-ai-blog/">How the system works</a>
      </p>
    </aside>

    <nav class="reading-path" aria-label="Start here">
      <span class="reading-path-label">New here?</span>
      <a class="reading-path-cta" href="/building/">Start with Building →</a>
    </nav>

    <nav class="filters" aria-label="Browse by topic">
      <a class="filter" href="/blog/" aria-current="page">All <span class="count">({posts.length})</span></a>
      {topics.map((t) => (
        <a class="filter" href={`/topics/${t.slug}/`}>{t.title}</a>
      ))}
      <a class="tag-alltags" href="/blog/tags/">All tags →</a>
    </nav>

    {
      posts.length === 0 ? (
        <p class="empty">New posts coming soon.</p>
      ) : (
        <>
          <ul class="grid">
            {recent.map((post) => {
              const cls = post.data.image ? 'card has-image' : 'card no-image';
              return (
                <li class="grid-cell">
                  <a href={`/blog/${post.id}/`} class={cls}>
                    <article>
                      {post.data.image ? (
                        <div class="card-image">
                          <Image
                            src={post.data.image.src}
                            alt={post.data.image.alt}
                            widths={[400, 700, 1000]}
                            sizes="(min-width: 768px) 420px, 100vw"
                          />
                        </div>
                      ) : null}
                      <div class="card-body">
                        <p class="card-meta">
                          <FormattedDate date={post.data.pubDate} format="short" />
                          {post.data.draft && (
                            <>
                              <span aria-hidden="true"> · </span>
                              <span class="draft-tag">Draft</span>
                            </>
                          )}
                        </p>
                        <h3 class="card-title">{post.data.title}</h3>
                        {post.data.description && (
                          <p class="card-desc">{post.data.description}</p>
                        )}
                        {post.data.tags?.length > 0 && (
                          <ul class="card-tags" aria-label="Tags">
                            {post.data.tags.map((t) => (
                              <li>{t}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </article>
                  </a>
                </li>
              );
            })}
          </ul>

          {archive.length > 0 && (
            <section class="archive" aria-labelledby="archive-h">
              <h2 id="archive-h">Archive</h2>
              <p class="archive-sub">{archive.length} earlier posts, grouped by month.</p>
              {[...byMonth.entries()].map(([month, group]) => (
                <details class="archive-month">
                  <summary>
                    {month} <span class="count">({group.length})</span>
                  </summary>
                  <ul class="archive-list">
                    {group.map((post) => (
                      <li>
                        <a href={`/blog/${post.id}/`}>
                          <span class="archive-title">{post.data.title}</span>
                          <FormattedDate date={post.data.pubDate} format="short" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </section>
          )}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 5rem 1.5rem 0;
  }
  .page-header {
    margin-bottom: 4rem;
    max-width: 42rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1.25rem;
    color: var(--fg);
  }
  .tagline {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.45;
    color: var(--fg);
    margin: 0 0 1.5rem;
    max-width: 36rem;
  }
  .lede {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 1.75rem;
    max-width: 38rem;
  }
  .lede a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--border);
    text-underline-offset: 0.18em;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  .lede a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .rss {
    margin: 0;
  }
  .rss a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .rss a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    padding: 2rem 0;
  }

  /* Tag filter */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  .filter {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0.12rem 0;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .filter:hover {
    color: var(--fg);
  }
  .filter[data-active] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .filter .count {
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.25em;
    font-variant-numeric: tabular-nums;
  }
  .filter[data-active] .count {
    color: color-mix(in oklab, var(--accent) 65%, var(--muted));
  }
  .filter-extra[hidden] {
    display: none;
  }
  .tag-more,
  .tag-alltags {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0.12rem 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .tag-more:hover {
    color: var(--fg);
  }
  .tag-alltags {
    color: color-mix(in oklab, var(--accent) 80%, var(--muted));
  }
  .tag-alltags:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Card grid */
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.5rem;
    height: 100%;
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card article {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: -0.25rem 0 1.1rem;
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .draft-tag {
    color: var(--accent);
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--fg);
    margin: 0;
  }
  .card-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    list-style: none;
    margin: auto 0 0;
    padding: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .card-tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.22rem 0.5rem;
    letter-spacing: 0.02em;
  }

  /* --- digest labeling & archive (2026-08 repositioning) --- */
  .auto-note {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
    padding: 1rem 1.25rem;
    margin: 0 0 1.75rem;
  }
  .auto-note p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .auto-note-links {
    margin-top: 0.5rem !important;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .auto-note-links a { color: var(--accent); text-decoration: none; }
  .auto-note-links a:hover { text-decoration: underline; }
  .auto-note-links span { color: var(--muted); padding: 0 0.4rem; }
  .reading-path {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .reading-path-label { color: var(--muted); }
  .reading-path-cta { color: var(--accent); text-decoration: none; }
  .reading-path-cta:hover { text-decoration: underline; }
  .filters a.filter,
  .filters a.tag-alltags {
    text-decoration: none;
  }
  .archive {
    margin-top: 3.5rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .archive h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem;
    color: var(--fg);
  }
  .archive-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .archive-month {
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
  }
  .archive-month summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
  }
  .archive-month summary .count { color: var(--muted); }
  .archive-list {
    list-style: none;
    margin: 0.75rem 0 0.4rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .archive-list a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    text-decoration: none;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }
  .archive-list a:hover .archive-title { color: var(--accent); }
  .archive-title { color: var(--fg); }
</style>
