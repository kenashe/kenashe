---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import related from '../../data/related.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const titleBySlug = new Map(posts.map((p) => [p.id, p.data.title]));
  const rel = related as Record<string, { slug: string; title: string }[]>;
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      relatedPosts: (rel[post.id] ?? [])
        .filter((r) => titleBySlug.has(r.slug))
        .map((r) => ({ slug: r.slug, title: titleBySlug.get(r.slug) as string })),
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  id={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  image={post.data.image}
  tags={post.data.tags}
  draft={post.data.draft}
  body={post.body ?? ''}
  relatedPosts={relatedPosts}
  sources={post.data.sources}
  entities={post.data.entities}
>
  <Content />
</BlogPost>
