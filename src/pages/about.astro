---
// Canonical About page: the one place the third-person bio lives. The first <p> after the
// <h1> is the bio verbatim, on purpose (entity resolution for search/LLM parsers). Do not
// put a hook above it or split it. Canonical URL is set automatically by BaseHead.
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { personKenAshe, websiteKenAshe } from '../data/schema';

// Self-contained entity graph, same as every other content page (DECISIONS.md D9): the
// canonical Person node is imported unchanged, and this page declares itself the
// ProfilePage whose mainEntity is that person. Do not fork or edit personKenAshe here.
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteKenAshe,
    {
      '@type': 'ProfilePage',
      '@id': 'https://kenashe.ai/about/#profile',
      url: 'https://kenashe.ai/about/',
      name: 'About Ken Ashe',
      mainEntity: { '@id': 'https://kenashe.ai/#ken-ashe' },
      about: { '@id': 'https://kenashe.ai/#ken-ashe' },
      isPartOf: { '@id': 'https://kenashe.ai/#website' },
      inLanguage: 'en-US',
    },
    personKenAshe,
  ],
};

const description = 'Ken Ashe is an AI application builder, CPA, and PMP based in New Jersey, shipping agents, automations, and AI-assisted websites in public.';
const links = [
  { href: '/building/', label: 'Building', text: 'The body of work: systems shipped under his real name, with dates, stacks, and honest notes on what broke.' },
  { href: '/writing/', label: 'Writing', text: 'Occasional essays, written by hand.' },
  { href: '/disclosure/', label: 'Disclosure', text: 'How everything on this site is made, including the labeled machine-published Digest, and who is accountable.' },
  { href: 'https://luckydomains.io', label: 'Lucky Domains', text: 'Domain acquisition, brokerage, and SEO.', external: true },
];
---

<BaseLayout
  title="About"
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]}
>
  <JsonLd slot="jsonld" data={aboutSchema} />

  <article class="about">
    <header class="about-header">
      <p class="page-mark" aria-hidden="true">// about</p>
      <h1>Ken Ashe</h1>
    </header>

    <div class="prose">
      <p class="bio">Ken Ashe is an AI application builder documenting real systems in public at KenAshe.ai, spanning AI agents, automations, AI-assisted websites, and marketing workflows. He works at the application layer, turning existing models, APIs, coding tools, and automation platforms into useful systems, and publishes the receipts: what shipped, what broke, and what others can learn. A CPA and PMP with a background in digital marketing and project management, Ken pairs operator discipline with hands-on building rather than commentary. He is also the founder of Lucky Domains, a domain acquisition, brokerage, and SEO company. Based in New Jersey, he builds with AI in public under his own name and treats the work itself, a navigable trail of real shipped systems, as the credential. KenAshe.ai is the canonical home for that record.</p>
    </div>

    <nav class="sections" aria-label="Elsewhere on the site">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                {l.label} <span aria-hidden="true">→</span>
              </a>
              <p>{l.text}</p>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="contact">
      <a href="mailto:hello@kenashe.ai">hello@kenashe.ai</a>
    </p>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
  }
  .about-header {
    margin-bottom: 2rem;
  }
  .page-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem;
  }
  .about-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
    color: var(--fg);
  }
  .prose {
    max-width: none;
  }
  .bio {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--fg);
    margin: 0;
  }
  .sections {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .sections ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .sections a {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .sections a:hover {
    color: var(--accent);
  }
  .sections a span {
    color: var(--accent);
  }
  .sections p {
    margin: 0.25rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .contact {
    margin: 2.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .contact a {
    color: var(--accent);
    text-decoration: none;
  }
  .contact a:hover {
    text-decoration: underline;
  }
</style>
