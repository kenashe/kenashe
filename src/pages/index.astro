---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BuildCard from '../components/BuildCard.astro';
import { SITE_DESCRIPTION } from '../consts';
import { featuredBuilds, remainingBuilds, totalBuilds, nextOnTheLog } from '../data/building-cards';
import { personKenAshe, websiteKenAshe } from '../data/schema';
import { homepageCredentials, CREDENTIAL_STATUS } from '../data/credentials';
import { essays, hrefFor } from '../data/writing';

// Writing: the two most recent essays (writing.ts is kept newest first).
const recentEssays = essays.slice(0, 2);

// Blog: latest 5 posts, newest first.
const allNotes = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const notes = allNotes
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Building: the featured cards plus a continuation to the full log. All counts come
// from src/data/building-cards.ts so they match /building/ exactly.
const latestBuilds = featuredBuilds;
const nextLine = nextOnTheLog();
const hasMore = remainingBuilds.length > 0;

// Three credibility cards: builder, operator, digital-assets. Tighter than the old
// six-card grid; Community Leader moved off the homepage per the 2026-08 repositioning.
const hats = [
  {
    label: 'AI application builder',
    body: 'Ships agents, automations, and AI-assisted sites at the application layer, then documents what shipped and what broke.',
  },
  {
    label: 'CPA & PMP operator',
    body: 'Proof, controls, and delivery. Strict financial discipline and decades of scoping, sequencing, and shipping real projects.',
  },
  {
    label: 'Domains & SEO operator',
    body: 'Founder of Lucky Domains: domain acquisition, brokerage, and SEO as a real business, not a take.',
  },
];

const credentials = homepageCredentials;

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteKenAshe,
    {
      '@type': 'ProfilePage',
      '@id': 'https://kenashe.ai/#profile',
      url: 'https://kenashe.ai/',
      name: 'Ken Ashe',
      mainEntity: { '@id': 'https://kenashe.ai/#ken-ashe' },
      about: { '@id': 'https://kenashe.ai/#ken-ashe' },
      isPartOf: { '@id': 'https://kenashe.ai/#website' },
      inLanguage: 'en-US',
    },
    personKenAshe,
  ],
};
---

<BaseLayout description={SITE_DESCRIPTION}>
  <JsonLd slot="jsonld" data={homeSchema} />

  <article class="home">
    <header class="hero">
      <h1 class="hero-headline">Ken Ashe</h1>
      <p class="hero-lead">I build practical AI applications, and document the receipts in public.</p>
      <p class="hero-sub">
        Agents, automations, AI-assisted websites, and workflow systems, under my real name. No
        hype, no doom. Receipts over rhetoric.
      </p>
      <div class="hero-ctas">
        <a class="cta cta-primary" href="/building/">
          See what I'm building
          <span aria-hidden="true">→</span>
        </a>
        <a class="cta cta-ghost" href="mailto:hello@kenashe.ai">Email Ken</a>
      </div>
      <p class="hero-tertiary">
        <a href="/writing/">Read the human notes →</a>
      </p>
    </header>

    <section aria-labelledby="building-heading" class="block">
      <div class="block-head">
        <h2 id="building-heading">
          Building{hasMore && (
            <span class="block-count">
              <span aria-hidden="true"> · </span>{latestBuilds.length} of {totalBuilds}
            </span>
          )}
        </h2>
        <a href="/building/" class="block-link">All builds →</a>
      </div>
      <ul class="receipts">
        {latestBuilds.map((p) => <BuildCard project={p} />)}
      </ul>
      {
        hasMore && (
          <div class="build-more">
            <a class="cta cta-outline cta-block" href="/building/">
              View all {totalBuilds} builds
              <span aria-hidden="true">→</span>
            </a>
            {nextLine && <p class="build-next">{nextLine}</p>}
          </div>
        )
      }
    </section>

    <section aria-labelledby="writing-heading" class="block">
      <div class="block-head">
        <h2 id="writing-heading">Recent Writing</h2>
        <a href="/writing/" class="block-link">View all writing →</a>
      </div>
      <ul class="essay-list">
        {
          recentEssays.map((e) => (
            <li>
              <a href={hrefFor(e)}>
                <span class="essay-date">{e.date}</span>
                <span class="essay-title">{e.title}</span>
                <span class="essay-dek">{e.dek}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="bring-heading" class="block">
      <div class="block-head"><h2 id="bring-heading">What I bring</h2></div>
      <p class="prose-p">
        I work at the AI application layer, turning existing models, APIs, coding tools, and
        automation platforms into working systems. Build first, test what actually happens,
        document the failures alongside the wins, and keep evidence separate from claims.
      </p>
      <ul class="hats">
        {
          hats.map((h) => (
            <li class="hat">
              <h3 class="hat-label">{h.label}</h3>
              <p class="hat-body">{h.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="creds-heading" class="block">
      <div class="block-head"><h2 id="creds-heading">Credentials</h2></div>
      <ul class="creds">
        {
          credentials.map((c) => (
            <li class="cred">
              <span class="cred-name">{c.name}</span>
              <span class="cred-issuer">{CREDENTIAL_STATUS}</span>
            </li>
          ))
        }
      </ul>
      <p class="creds-more"><a href="/about/" class="block-link">All credentials →</a></p>
    </section>

    <section aria-labelledby="hire-heading" class="hire">
      <h2 id="hire-heading" class="sr-only">Work with me</h2>
      <p class="hire-line">
        Founders and operators: if you want an AI system shipped, or domain and SEO help through
        Lucky Domains, email me.
      </p>
      <p class="hire-links">
        <a href="mailto:hello@kenashe.ai">hello@kenashe.ai</a>
        <span aria-hidden="true">·</span>
        <a href="https://luckydomains.io" target="_blank" rel="noopener">luckydomains.io</a>
      </p>
    </section>

    <section aria-labelledby="blog-heading" class="block">
      <div class="block-head">
        <h2 id="blog-heading">From the digest <span class="auto-tag">(automated)</span></h2>
        <a href="/blog/" class="block-link">Full digest →</a>
      </div>
      <ul class="post-list">
        {
          notes.map((note) => (
            <li>
              <a href={`/blog/${note.id}/`}>
                <span class="post-title">
                  {note.data.draft && <span class="draft-tag">[Draft]</span>}
                  {note.data.title}
                </span>
                <span class="post-date">
                  <FormattedDate date={note.data.pubDate} format="short" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="closing">
      Ken Ashe is an AI application builder, CPA, and PMP building with AI in public, and the
      founder of Lucky Domains, a domain acquisition, brokerage, and SEO services company.
    </p>
  </article>
</BaseLayout>

<style>
  .home {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 5rem 1.5rem 0;
  }

  /* Hero */
  .hero {
    margin-bottom: 5rem;
  }
  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    color: var(--fg);
  }
  .hero-lead {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    color: var(--fg);
    margin: 0 0 0.85rem;
  }
  .hero-sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.7rem 1.15rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }
  .cta-primary {
    background-color: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
  }
  .cta-primary:hover {
    background-color: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .cta-ghost {
    background-color: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .cta-ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Sections */
  .block {
    margin-top: 3.5rem;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .block h2 {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .block-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
  }
  .block-link:hover {
    color: var(--fg);
  }
  .block-count {
    text-transform: none; /* keep "of" lowercase inside the uppercase heading */
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* Building continuation: clearly part of Building, spaced away from Work with me. */
  .build-more {
    margin: 1.75rem 0 3rem;
  }
  .cta-block {
    display: flex;
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 0.85rem 1.25rem;
  }
  /* Building continuation styled as one more card: same surface, border, radius and
     hover lift as .receipt in BuildCard.astro, so at rest it is indistinguishable from
     the cards above it. Only the hero keeps a solid-yellow button. */
  .cta-outline {
    background-color: var(--surface);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition:
      border-color 200ms ease,
      transform 200ms ease,
      color 150ms ease;
  }
  .cta-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
  .cta-outline:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .cta-outline:active {
    transform: translateY(0);
    border-color: var(--accent);
  }
  .build-next {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* What I bring */
  .hats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .hat {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.4rem 1.4rem 1.25rem;
  }
  .hat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .hat-body {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--fg);
    margin: 0;
  }

  /* Build cards */
  .receipts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  /* How I work */
  .prose-p {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 1.25rem;
  }
  .prose-p:last-child {
    margin-bottom: 0;
  }

  /* Stack */

  /* Credentials */
  .creds {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cred {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cred-name {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--fg);
  }
  .creds-more {
    margin: 0.9rem 0 0;
  }
  .cred-issuer {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }

  /* Recent Writing: same list treatment as /writing/ */
  .essay-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .essay-list li + li {
    border-top: 1px solid var(--rule);
  }
  .essay-list a {
    display: block;
    padding: 1.1rem 0;
    text-decoration: none;
    color: inherit;
  }
  .essay-list a:hover .essay-title {
    color: var(--accent);
  }
  .essay-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .essay-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 0.3rem;
    transition: color 150ms ease;
  }
  .essay-dek {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Blog list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    margin-bottom: 0.25rem;
  }
  .post-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    padding: 0.4rem 0;
  }
  .post-title {
    font-size: 1.0625rem;
    flex: 1;
  }
  .post-list a:hover .post-title {
    color: var(--accent);
  }
  .post-date {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .draft-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-right: 0.4rem;
  }

  /* Principles */

  /* Closing boilerplate */
  .closing {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 3.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .hero-tertiary {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .hero-tertiary a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .hero-tertiary a:hover {
    color: var(--accent);
  }
  .hire {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2.25rem 1.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .hire-line {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 0.6rem;
    max-width: 44rem;
  }
  .hire-links {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .hire-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .hire-links a:hover {
    text-decoration: underline;
  }
  .hire-links span {
    color: var(--muted);
    padding: 0 0.5rem;
  }
  .auto-tag {
    font-family: var(--font-mono);
    font-size: 0.7em;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
